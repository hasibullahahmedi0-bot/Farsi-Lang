// برنامه ماشین حساب ساده
تابع جمع(الف، ب) {
    برگردان الف + ب
}

تابع تفریق(الف، ب) {
    برگردان الف - ب
}

تابع ضرب(الف، ب) {
    برگردان الف * ب
}

تابع تقسیم(الف، ب) {
    اگر (ب == 0) {
        نوشتن("خطا: تقسیم بر صفر!")
        برگردان تهی
    }
    برگردان الف / ب
}

// آزمایش
نوشتن("5 + 3 =")
نوشتن(جمع(5, 3))

نوشتن("10 - 4 =")
نوشتن(تفریق(10, 4))

نوشتن("6 * 7 =")
نوشتن(ضرب(6, 7))

نوشتن("20 / 4 =")
نوشتن(تقسیم(20, 4))
